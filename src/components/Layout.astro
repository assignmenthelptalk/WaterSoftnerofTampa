---
import { SEO } from "astro-seo";
import { site } from "../lib/site";
import "../styles/global.css";
import "../styles/tailwind.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.metaDescription, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, site.siteUrl).toString();

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/water-quality/", label: "Water Quality" },
  { href: "/hard-water/", label: "Hard Water" },
  { href: "/installation/", label: "Installation" },
  { href: "/comparison/", label: "Compare" },
  { href: "/faq/", label: "FAQ" },
  { href: "/neighbourhood/", label: "Neighbourhoods" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={`${title} | ${site.businessName}`}
      description={description}
      canonical={canonical}
      noindex={noindex}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: `${site.siteUrl}/og-default.jpg`,
          url: canonical,
        },
      }}
      twitter={{ card: "summary_large_image" }}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="logo" href="/">
          {site.businessName}
        </a>
        <nav class="site-nav" aria-label="Primary">
          <ul>
            {navLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="btn btn-primary btn-sm" href="/quote/">Get a Free Quote</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <div>
          <p class="footer-business">{site.businessName}</p>
          <p>{site.address || `Serving ${site.city}, ${site.stateAbbr}`}</p>
          {site.phone && <p><a href={`tel:${site.phone}`}>{site.phone}</a></p>}
          {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
          {site.googleBusinessUrl && (
            <p><a href={site.googleBusinessUrl} target="_blank" rel="noopener noreferrer">Google Business Profile</a></p>
          )}
        </div>
        <nav aria-label="Footer">
          <ul>
            {navLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
            <li><a href="/quote/">Get a Quote</a></li>
          </ul>
        </nav>
      </div>
      <p class="footer-copyright">&copy; {new Date().getFullYear()} {site.businessName}. All rights reserved.</p>
    </footer>

    {import.meta.env.DEV && (
      <a href="/keystatic" class="keystatic-dev-bar">Edit Site Settings (Keystatic)</a>
    )}

    <style>
      .site-header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding-block: 16px;
      }
      .logo {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.125rem;
        color: var(--brand-primary);
        text-decoration: none;
      }
      .site-nav ul {
        display: flex;
        gap: 20px;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .site-nav a {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--color-text-muted);
        text-decoration: none;
      }
      .site-nav a:hover { color: var(--brand-accent-dark); }
      .btn-sm { padding: 10px 18px; font-size: 0.8125rem; white-space: nowrap; }

      .site-footer {
        background: var(--brand-secondary);
        color: #cbd5e1;
        padding: 48px 0 24px;
        margin-top: 64px;
      }
      .site-footer-inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 32px;
      }
      .site-footer a { color: #e0f2fe; }
      .footer-business { font-family: var(--font-display); font-weight: 700; color: #ffffff; margin: 0 0 8px; }
      .site-footer nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
      .footer-copyright {
        text-align: center;
        font-size: 0.8125rem;
        color: #64748b;
        margin: 32px 0 0;
      }

      .keystatic-dev-bar {
        position: fixed;
        bottom: 16px;
        right: 16px;
        background: #0f172a;
        color: #ffffff;
        font-family: var(--font-display);
        font-size: 0.8125rem;
        font-weight: 600;
        padding: 10px 16px;
        border-radius: var(--radius-full);
        text-decoration: none;
        box-shadow: var(--shadow-lg);
        z-index: 999;
      }

      @media (max-width: 860px) {
        .site-nav { display: none; }
      }
    </style>
  </body>
</html>
