---
/**
 * ContentProse: typography wrapper for imported markdown pages.
 * Scoped styles reach the rendered markdown through :global selectors.
 * [NEEDS DATA] / [VERIFY] markers render as <mark class="data-gap"> and are
 * deliberately loud so unresolved facts cannot be missed in review.
 */
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: 780px;
    margin: 0 auto;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin: 2.6em 0 0.6em;
    padding-top: 0.9em;
    border-top: 3px solid var(--color-accent);
    max-width: 32ch;
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) {
    font-size: 1.3rem;
    margin: 1.8em 0 0.4em;
  }
  .prose :global(p) { margin: 0 0 1.1em; line-height: 1.75; }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 1.4em; padding-left: 1.4em; }
  /* Tailwind's preflight resets list styles; restore them for article copy */
  .prose :global(ul) { list-style: disc; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(li) { margin-bottom: 0.55em; line-height: 1.7; }
  .prose :global(li::marker) { color: var(--color-accent); font-weight: 700; }
  .prose :global(strong) { color: var(--color-text); }

  .prose :global(a) {
    color: var(--color-primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .prose :global(a:hover) { color: var(--color-accent-dark); }

  /* Trust-layer callouts ("Not a good fit if...", "What owners tell us") */
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 18px 22px;
    background: var(--color-primary-light);
    border-left: 4px solid var(--color-primary);
    border-radius: 0 var(--radius-brand) var(--radius-brand) 0;
    box-shadow: var(--shadow-card);
  }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }

  /* Comparison / price tables */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.6em 0;
    font-size: 0.95rem;
    background: var(--surface-base);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-brand);
    overflow: hidden;
    display: block;
    overflow-x: auto;
  }
  .prose :global(th) {
    background: var(--color-primary);
    color: #ffffff;
    text-align: left;
    padding: 12px 14px;
    font-weight: 600;
  }
  .prose :global(td) {
    padding: 12px 14px;
    border-top: 1px solid var(--color-border);
    vertical-align: top;
  }
  .prose :global(tr:nth-child(even) td) { background: var(--surface-elevated); }

  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.8em 0;
    border-radius: var(--radius-brand);
    box-shadow: var(--shadow-card);
  }

  /* Unresolved facts: loud on purpose */
  .prose :global(mark.data-gap),
  :global(mark.data-gap) {
    background: #fff3b0;
    color: #5c4300;
    padding: 1px 6px;
    border-radius: 4px;
    outline: 1px dashed #b88700;
    font-size: 0.9em;
    font-weight: 600;
  }

  /* Every section heading is a full-width navy band. The box-shadow and clip-path paint the band edge to
     edge without extra markup or a 100vw width, so there is no horizontal scroll. */
  .prose > :global(h2),
  .prose > :global(h2:first-child) {
    background: var(--color-primary);
    color: #fff;
    text-align: center;
    max-width: none;
    border-top: 0;
    padding: 2rem 1rem;
    margin: 3rem 0 2rem;
    box-shadow: 0 0 0 100vmax var(--color-primary);
    clip-path: inset(0 -100vmax);
  }
  /* Homepage services: a 3-column card grid that breaks out of the 780px text column */
  .prose :global(.svc-grid) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.2rem 2rem;
    width: min(1100px, calc(100vw - 2rem));
    margin: 1.8rem 0 1.8rem 50%;
    transform: translateX(-50%);
  }
  .prose :global(.svc-card > p:first-child) { margin: 0 0 1rem; }
  .prose :global(.svc-card img) { margin: 0; aspect-ratio: 3 / 2; object-fit: cover; box-shadow: none; }
  .prose :global(.svc-card h3) { margin: 0 0 0.5rem; font-size: 1.2rem; }
  .prose :global(.svc-card p) { font-size: 0.97rem; line-height: 1.65; margin: 0; }
  @media (max-width: 900px) { .prose :global(.svc-grid) { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .prose :global(.svc-grid) { grid-template-columns: 1fr; } }

  /* Homepage installation steps: photo on the left, "Step N: Title" blocks on the right */
  .prose :global(.steps-split) {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2.5rem;
    align-items: start;
    width: min(1100px, calc(100vw - 2rem));
    margin: 1.8rem 0 1.8rem 50%;
    transform: translateX(-50%);
  }
  .prose :global(.steps-photo > p) { margin: 0; }
  .prose :global(.steps-photo img) { margin: 0; aspect-ratio: 4 / 5; object-fit: cover; }
  .prose :global(.steps-list h3) { margin: 0 0 0.45rem; font-size: 1.3rem; }
  .prose :global(.steps-list h3:not(:first-child)) { margin-top: 1.9rem; }
  .prose :global(.steps-list p) { margin: 0; }
  @media (max-width: 800px) { .prose :global(.steps-split) { grid-template-columns: 1fr; gap: 1.5rem; } }

  /* Homepage "issues" block: tall photo on the left, two columns of titled text blocks on the right */
  .prose :global(.issues-split) {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 2.5rem;
    align-items: start;
    width: min(1100px, calc(100vw - 2rem));
    margin: 1.8rem 0 1.8rem 50%;
    transform: translateX(-50%);
  }
  .prose :global(.issues-photo) { position: sticky; top: 6.5rem; }
  .prose :global(.issues-photo > p) { margin: 0; }
  .prose :global(.issues-photo img) { margin: 0; aspect-ratio: 4 / 5; object-fit: cover; }
  .prose :global(.issues-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 2.2rem; }
  .prose :global(.issue-item h3) { margin: 0 0 0.45rem; font-size: 1.2rem; }
  .prose :global(.issue-item p) { margin: 0; font-size: 0.97rem; line-height: 1.65; }
  @media (max-width: 900px) { .prose :global(.issues-split) { grid-template-columns: 1fr; gap: 1.5rem; } .prose :global(.issues-photo) { position: static; } }
  @media (max-width: 600px) { .prose :global(.issues-grid) { grid-template-columns: 1fr; } }

  /* Homepage "why us" block: photo on the left; bold heading, intro, six compact checks, a button and
     certification chips on the right */
  .prose :global(.why-split) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: stretch;
    width: min(1100px, calc(100vw - 2rem));
    margin: 2rem 0 2rem 50%;
    transform: translateX(-50%);
  }
  /* The photo fills the height of the text column; the crop stays centred on the softener */
  .prose :global(.why-photo) {
    position: relative;
    min-height: 360px;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 18px 40px -22px rgba(15, 23, 42, 0.45);
  }
  .prose :global(.why-photo > p) { margin: 0; }
  .prose :global(.why-photo img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: 0;
    box-shadow: none;
    object-fit: cover;
    object-position: 48% 50%;
  }
  .prose :global(.why-text) { align-self: center; }
  .prose :global(.why-text h2) {
    text-align: left;
    max-width: none;
    margin: 0 0 1.1rem;
    padding: 0;
    border-top: 0;
    color: var(--color-accent);
    font-size: clamp(1.8rem, 3.1vw, 2.6rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .prose :global(.why-text > p:first-of-type) {
    margin: 0 0 1.4rem;
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--color-text);
  }
  /* Six compact checks, two per row, a thin divider between the columns */
  .prose :global(.why-text ul) {
    list-style: none;
    margin: 0 0 1.8rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 0;
  }
  .prose :global(.why-text li) {
    position: relative;
    margin: 0;
    padding: 0 0.8rem 0 1.9rem;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-text);
  }
  .prose :global(.why-text li:nth-child(even)) { padding-left: 2.9rem; border-left: 1px solid #cbd5e1; }
  /* Blue check mark */
  .prose :global(.why-text li::before) {
    content: "";
    position: absolute;
    left: 0.25rem;
    top: 0.12em;
    width: 0.5rem;
    height: 0.9rem;
    border: solid var(--color-accent);
    border-width: 0 3px 3px 0;
    transform: rotate(45deg);
  }
  .prose :global(.why-text li:nth-child(even)::before) { left: 1.25rem; }
  .prose :global(.why-text > p:nth-of-type(2)) { margin: 0 0 1.4rem; }
  .prose :global(.why-text > p:nth-of-type(2) a) {
    display: block;
    width: min(100%, 30rem);
    text-align: center;
    background: var(--color-accent);
    color: #fff;
    padding: 1rem 1.4rem;
    border-radius: 8px;
    font-weight: 800;
    font-size: 1.02rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 10px 22px -12px rgba(29, 78, 216, 0.7);
    transition: background-color 150ms ease, transform 150ms ease;
  }
  .prose :global(.why-text > p:nth-of-type(2) a:hover) { background: var(--color-accent-dark); color: #fff; transform: translateY(-1px); }
  .prose :global(.why-text > p:nth-of-type(2) a:focus-visible) { outline: 3px solid var(--color-primary); outline-offset: 3px; }
  /* Certification marks under the button: three white tiles in a row */
  .prose :global(.why-badges) { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; }
  .prose :global(.why-badges > p) { margin: 0; }
  .prose :global(.why-badges img) {
    display: block;
    height: 4.4rem;
    width: auto;
    max-width: 100%;
    margin: 0;
    padding: 0.2rem 0.5rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: none;
  }
  /* The six benchmarks in full, below the banner: tinted rows with a blue check badge, two per row */
  .prose :global(.why-details) {
    width: min(1100px, calc(100vw - 2rem));
    margin: 0 0 2rem 50%;
    transform: translateX(-50%);
  }
  .prose :global(.why-details ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .prose :global(.why-details li) {
    position: relative;
    margin: 0;
    padding: 0.8rem 1rem 0.8rem 3.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
    background: #f1f7ff;
    border: 1px solid #dbe7fb;
    border-radius: var(--radius-lg);
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .prose :global(.why-details li:hover) {
    border-color: #93b4f0;
    box-shadow: 0 6px 16px -10px rgba(37, 99, 235, 0.45);
  }
  .prose :global(.why-details li::before) {
    content: "";
    position: absolute;
    left: 0.9rem;
    top: 0.85rem;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb 0%, #0ea5e9 100%);
    box-shadow: 0 3px 8px -2px rgba(37, 99, 235, 0.5);
  }
  .prose :global(.why-details li::after) {
    content: "";
    position: absolute;
    left: 1.55rem;
    top: 1.12rem;
    width: 0.32rem;
    height: 0.62rem;
    border: solid #ffffff;
    border-width: 0 2.5px 2.5px 0;
    border-radius: 1px;
    transform: rotate(45deg);
  }
  .prose :global(.why-details li strong) { color: var(--color-primary-dark); }
  /* Phones and narrow tablets: photo on top, then the text; the checks go to one column on small phones */
  @media (max-width: 800px) {
    .prose :global(.why-split) { grid-template-columns: 1fr; gap: 1.6rem; }
    .prose :global(.why-photo) { min-height: 0; aspect-ratio: 4 / 3; }
    .prose :global(.why-details ul) { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .prose :global(.why-badges) { gap: 0.5rem; flex-wrap: nowrap; }
    .prose :global(.why-badges img) { height: 3.3rem; padding: 0.15rem 0.35rem; }
    .prose :global(.why-text ul) { grid-template-columns: 1fr; }
    .prose :global(.why-text li:nth-child(even)) { padding-left: 1.9rem; border-left: 0; }
    .prose :global(.why-text li:nth-child(even)::before) { left: 0.25rem; }
  }

  /* FAQ: question rows that open on click (<details>), on a light panel, like the roofing-site accordion */
  .prose :global(.faq-list) { background: #eef1f5; padding: 1rem; border-radius: var(--radius-brand); margin: 0 0 2rem; }
  .prose :global(.faq-item) { background: #fff; margin: 0 0 3px; border-radius: 4px; }
  .prose :global(.faq-item:last-child) { margin-bottom: 0; }
  .prose :global(.faq-item > summary) {
    list-style: none;
    cursor: pointer;
    padding: 0.95rem 3rem 0.95rem 1.2rem;
    font-weight: 600;
    color: var(--color-primary);
    position: relative;
  }
  .prose :global(.faq-item > summary::-webkit-details-marker) { display: none; }
  .prose :global(.faq-item > summary::after) {
    content: "";
    position: absolute;
    right: 1.3rem;
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid var(--color-accent);
    border-bottom: 2px solid var(--color-accent);
    transform: translateY(-70%) rotate(45deg);
    transition: transform 0.15s;
  }
  .prose :global(.faq-item[open] > summary::after) { transform: translateY(-30%) rotate(-135deg); }
  .prose :global(.faq-item > summary:hover) { background: var(--color-primary-light); }
  .prose :global(.faq-item > summary:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: -2px; }
  .prose :global(.faq-item > p) { margin: 0 0 0.9rem; padding: 0 1.2rem; font-size: 0.98rem; }
  .prose :global(.faq-item > p:last-child) { margin-bottom: 1.1rem; }

  @media (max-width: 640px) {
    .prose { font-size: 1rem; }
    .prose :global(h2) { max-width: none; }
  }
</style>
