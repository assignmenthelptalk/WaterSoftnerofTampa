---
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { site } from "../lib/site";
import headerImage from "../assets/images/quote-header.webp";
---

<Layout
  title={`Get a Free Water Softener Quote — ${site.city}`}
  description={`Request a free, no-obligation water softener quote for your home in ${site.city}, ${site.stateAbbr}.`}
>
  <section class="page-header">
    <div class="container">
      <Breadcrumbs items={[{ label: "Get a Quote" }]} />
      <p class="eyebrow">{site.city}, {site.stateAbbr}</p>
      <h1>Get a Free Water Softener Quote in {site.city}</h1>
    </div>
  </section>

  <section class="page-header-image-section">
    <div class="container">
      <Image src={headerImage} alt={`Technician reviewing a written water softener quote with a ${site.city}, ${site.stateAbbr} homeowner`} class="page-header-image" width={1600} height={500} loading="eager" />
    </div>
  </section>

  <section class="section quote-section">
    <div class="container">
      <p class="brand-backlink">
        <a href="/" class="brand-link">{site.city} Water Softeners</a>
        {" "}provides free water testing and no-obligation quotes across {site.city} and {site.county}.
      </p>
    </div>
    <div class="container quote-grid">
      <div>
        <p>Tell us a bit about your home and we'll follow up with a no-obligation recommendation and price, sized for {site.city}'s {site.gpgLow}–{site.gpgHigh} GPG water.</p>
        <ul class="quote-benefits">
          <li>Free in-home or virtual water hardness test</li>
          <li>No-obligation, transparent pricing</li>
          <li>Local installation across {site.county}</li>
        </ul>
        {site.phoneNumber !== "PHONE_NUMBER" && (
          <p class="quote-phone">Prefer to talk now? Call <a href={`tel:${site.phoneNumber}`}>{site.phoneNumber}</a></p>
        )}
        <p class="quote-links">
          Not ready to request a quote yet? See{" "}
          <a href="/installation/">Water Softener Installation in Tampa: Process, Timeline &amp; Cost</a>{" "}
          or the <a href="/faq/">Water Softener FAQs for Tampa Homeowners</a> first.
        </p>
      </div>
      <QuoteForm />
    </div>
  </section>

  <style>
    .quote-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: start;
    }
    .quote-benefits { padding-left: 20px; color: var(--color-text-muted); }
    .quote-benefits li { margin-bottom: 8px; }
    .quote-phone { margin-top: 24px; font-weight: 600; }
    .quote-links { margin-top: 16px; font-size: 14px; color: var(--color-text-muted); }
    @media (max-width: 860px) {
      .quote-grid { grid-template-columns: 1fr; }
    }
  </style>
</Layout>
