---
/**
 * Homepage. Hero: full-bleed photo under a dark glass-style wash (radial glow, fine grid, glass badges,
 * gradient headline, stat row), content on the left and the compact quote form on the right.
 * The form lives in the hero (anchor #estimate), so the separate lead-form
 * section from the original spec was folded into it. The form itself is QuoteForm, unchanged.
 *
 * Copy comes from src/data/pages/home.md. Body copy contains no links to
 * service, guide or location pages (navigation and footer only).
 *
 * Hero photo: the first src/assets/images/hero-*.webp (made by
 * scripts/prepare-images.mjs). Until one exists the page shows a labelled
 * local placeholder image so the build never breaks.
 */
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import QuoteForm from "../components/QuoteForm.astro";
import ContentProse from "../components/ContentProse.astro";
import PageSchema from "../components/PageSchema.astro";
import NeighbourhoodMap from "../components/NeighbourhoodMap.astro";
import { site } from "../lib/site";
import { Content, frontmatter as fm } from "../data/pages/home.md";
import { Content as ContentAfter, frontmatter as afterFm } from "../data/home-after.md";

const telHref = `tel:${site.phoneNumber.replace(/[^\d+]/g, "")}`;
const heroFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/images/hero-*.webp", { eager: true });
const heroImage = Object.values(heroFiles)[0]?.default;
const HERO_PLACEHOLDER = "/placeholders/hero.svg"; // local file in public/placeholders (no network at build)
// Trust claims below (licensing, certifications, permits, warranty, scale elimination) were supplied by the site
// owner from the hero design; confirm each one with the installer before launch.
const ICONS = {
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  award: '<path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/>',
  check: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
  pin: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
};
const badges = [
  { label: "Licensed & Insured FL Plumbers", icon: ICONS.shield, tone: "cyan" },
  { label: "WQA-Certified Technicians", icon: ICONS.award, tone: "green" },
  { label: "NSF/ANSI-Certified Systems", icon: ICONS.check, tone: "blue" },
  { label: "Hillsborough County Permitted", icon: ICONS.pin, tone: "cyan" },
];
// Title is "Business Name - Service in City, ST": the brand is the first headline line, the rest the gradient line.
const [heroH1, heroRest] = fm.title.split(" - ");
const stats = [
  { value: String(site.gpgLow), unit: "GPG", label: "Tampa avg hardness", tone: "" },
  { value: "100%", unit: "", label: "Scale elimination", tone: "green" },
  { value: "10-Yr", unit: "", label: "Equipment warranty", tone: "" },
];
---

<Layout title={fm.title} fullTitle={fm.seoTitle} description={fm.description}>
  <PageSchema faq={fm.faq} />

  <!-- 1. HERO: full-bleed image under a dark glass wash, content left, quote form right -->
  <section class="hero-section">
    <Image
      src={heroImage ?? HERO_PLACEHOLDER}
      alt={fm.leadImage?.alt ?? `Professional water softener installation and service in ${site.city}, ${site.stateAbbr}`}
      {...(heroImage ? {} : { width: 1376, height: 768 })}
      format="webp"
      quality="mid"
      loading="eager"
      class="hero-bg"
    />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-a" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-b" aria-hidden="true"></div>

    <div class="hero-inner">
      <div class="hero-content">
        <div class="hero-badges">
          {badges.map((badge) => (
            <span class:list={["hero-badge", `hero-badge-${badge.tone}`]}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={badge.icon} />
              {badge.label}
            </span>
          ))}
        </div>

        <p class="hero-pill">
          <span class="hero-pill-dot" aria-hidden="true"></span>
          Tampa Water Department 2025 report
        </p>

        <h1 class="hero-h1">
          {heroH1}
          {heroRest && <span class="hero-h1-accent">{heroRest}</span>}
        </h1>

        <p class="hero-p" set:html={fm.openingHtml} />
        {fm.openingExtraHtml && <p class="hero-p" set:html={fm.openingExtraHtml} />}

        <div class="hero-ctas">
          <a href="#estimate" class="hero-cta-primary">
            Get Free System Estimate
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
          <a href={telHref} class="hero-cta-phone">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 1.5h2.2l1 3-1.6 1.2a9 9 0 0 0 4.2 4.2l1.2-1.6 3 1v2.2c0 .8-.7 1.4-1.4 1.3C7 12.4 3.6 9 3.2 3.9c-.1-.7.5-1.4 1.3-1.4Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
            </svg>
            {site.phoneNumber}
          </a>
        </div>

        <dl class="hero-stats">
          {stats.map((stat) => (
            <div class="hero-stat">
              <dt class:list={["hero-stat-value", { "hero-stat-green": stat.tone === "green" }]}>
                {stat.value}
                {stat.unit && <span class="hero-stat-unit">{stat.unit}</span>}
              </dt>
              <dd class="hero-stat-label">{stat.label}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="hero-form-card" id="estimate">
        <QuoteForm heading="Get a Free Estimate" compact />
      </div>
    </div>
  </section>

  <!-- 2 to 9. Page copy: why choose us, services, hard water, process, FAQ, areas -->
  <section class="section">
    <div class="container">
      <ContentProse>
        <Content />
      </ContentProse>
    </div>
  </section>

  <!-- Neighbourhood map: directly below the hard-water section. The importer splits the homepage copy there
       (home.md up to it, home-after.md the rest); with no pins the map renders nothing and nothing is split. -->
  <NeighbourhoodMap />

  {afterFm.split && (
    <section class="section">
      <div class="container">
        <ContentProse>
          <ContentAfter />
        </ContentProse>
      </div>
    </section>
  )}

  <style>
    /* ---------- Hero: full-bleed image, dark glass wash, split layout ---------- */
    .hero-section {
      --hero-ink: 5, 9, 20;
      --hero-cyan: #38bdf8;
      --hero-cyan-strong: #0ea5e9;
      --hero-blue: #2563eb;
      position: relative;
      min-height: 0;
      display: flex;
      align-items: center;
      overflow: hidden;
    }

    .hero-section :global(.hero-bg) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 0%; /* keep the top of the photo; its lower edge carries a stamped logo plate */
      z-index: 0;
    }

    /* Darker on the left where the text sits, lighter toward the form. The bottom fade also covers the logo
       plate stamped into the lower edge of the photo. */
    .hero-overlay {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          to top,
          rgba(var(--hero-ink), 0.97) 0%,
          rgba(var(--hero-ink), 0.9) 16%,
          rgba(var(--hero-ink), 0) 42%
        ),
        linear-gradient(
          to right,
          rgba(var(--hero-ink), 0.8) 0%,
          rgba(var(--hero-ink), 0.68) 50%,
          rgba(var(--hero-ink), 0.38) 100%
        );
      z-index: 1;
    }

    /* Soft cyan and blue glow from the top, then a fine 40px grid over everything */
    .hero-grid {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background-image:
        radial-gradient(circle at 50% 0%, rgba(14, 165, 233, 0.18) 0%, rgba(37, 99, 235, 0.09) 35%, rgba(5, 9, 20, 0) 70%),
        linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
      background-size: 100% 100%, 40px 40px, 40px 40px;
    }
    .hero-glow {
      position: absolute;
      z-index: 1;
      border-radius: 50%;
      pointer-events: none;
    }
    .hero-glow-a {
      top: -120px;
      left: 38%;
      width: 520px;
      height: 520px;
      background: rgba(14, 165, 233, 0.12);
      filter: blur(110px);
    }
    .hero-glow-b {
      top: 20%;
      right: 4%;
      width: 360px;
      height: 360px;
      background: rgba(37, 99, 235, 0.14);
      filter: blur(90px);
    }

    .hero-inner {
      position: relative;
      z-index: 2;
      max-width: 1100px;
      margin: 0 auto;
      padding: 44px 24px 52px;
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 44px;
      align-items: start;
      width: 100%;
    }

    /* Glass badges */
    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 18px;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 600;
      color: #e2e8f0;
      background: rgba(14, 165, 233, 0.1);
      border: 1px solid rgba(56, 189, 248, 0.28);
      border-radius: var(--radius-full);
      padding: 6px 14px 6px 11px;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .hero-badge svg { color: var(--hero-cyan); flex: none; }
    .hero-badge-green svg { color: #34d399; }
    .hero-badge-blue svg { color: #60a5fa; }

    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 18px;
      padding: 5px 13px;
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 500;
      color: #bae6fd;
      background: rgba(14, 165, 233, 0.1);
      border: 1px solid rgba(14, 165, 233, 0.25);
      border-radius: var(--radius-full);
    }
    .hero-pill-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--hero-cyan);
    }

    .hero-h1 {
      font-family: var(--font-heading);
      font-size: clamp(28px, 4.2vw, 48px);
      font-weight: 800;
      color: #ffffff;
      line-height: 1.12;
      letter-spacing: -0.025em;
      margin-bottom: 20px;
      text-wrap: balance;
    }
    .hero-h1-accent {
      display: block;
      margin-top: 4px;
      color: #7dd3fc; /* fallback where background-clip text is unsupported */
      background: linear-gradient(90deg, #7dd3fc 0%, #93c5fd 55%, #c7d2fe 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-p {
      font-family: var(--font-body);
      font-size: 16px;
      color: #cbd5e1;
      line-height: 1.75;
      margin-bottom: 16px;
      max-width: 580px;
    }
    /* Brand name and figures in the opening copy: solid white and bold against the softer body text */
    .hero-p :global(strong) {
      color: #ffffff;
      font-weight: 700;
    }
    .hero-p :global(a) {
      color: #ffffff;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .hero-p :global(a:hover) { color: #bae6fd; }
    .hero-p :global(a:focus-visible) { outline: 3px solid #ffffff; outline-offset: 2px; border-radius: 2px; }

    /* Call to action pair: gradient primary, glass phone button */
    .hero-ctas {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      margin: 26px 0 30px;
    }
    .hero-cta-primary,
    .hero-cta-phone {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px 26px;
      border-radius: 12px;
      font-family: var(--font-body);
      font-size: 16px;
      font-weight: 700;
      text-decoration: none;
      transition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease, border-color 150ms ease;
    }
    .hero-cta-primary {
      color: #ffffff;
      background: linear-gradient(90deg, #0284c7 0%, var(--hero-blue) 55%, #1d4ed8 100%);
      box-shadow: 0 10px 28px -8px rgba(14, 165, 233, 0.5);
    }
    .hero-cta-primary:hover {
      color: #ffffff;
      transform: translateY(-2px);
      box-shadow: 0 14px 32px -8px rgba(14, 165, 233, 0.65);
    }
    .hero-cta-primary svg { transition: transform 150ms ease; }
    .hero-cta-primary:hover svg { transform: translateX(3px); }
    .hero-cta-phone {
      color: #e2e8f0;
      background: rgba(15, 23, 42, 0.72);
      border: 1px solid rgba(100, 116, 139, 0.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .hero-cta-phone svg { color: var(--hero-cyan); }
    .hero-cta-phone:hover {
      color: #ffffff;
      background: rgba(30, 41, 59, 0.85);
      border-color: rgba(148, 163, 184, 0.8);
    }
    .hero-cta-primary:focus-visible,
    .hero-cta-phone:focus-visible { outline: 3px solid #ffffff; outline-offset: 3px; }
    .hero-cta-primary:active,
    .hero-cta-phone:active { transform: scale(0.98); }

    /* Stat row */
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, auto);
      justify-content: start;
      gap: 0;
      margin: 0;
      padding-top: 22px;
      max-width: 580px;
      border-top: 1px solid rgba(148, 163, 184, 0.25);
    }
    .hero-stat { padding: 0 22px; }
    .hero-stat:first-child { padding-left: 0; }
    .hero-stat + .hero-stat { border-left: 1px solid rgba(148, 163, 184, 0.25); }
    .hero-stat-value {
      display: flex;
      align-items: baseline;
      gap: 5px;
      font-family: var(--font-heading);
      font-size: 22px;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.2;
      font-variant-numeric: tabular-nums;
    }
    .hero-stat-green { color: #34d399; }
    .hero-stat-unit { font-size: 13px; font-weight: 600; color: var(--hero-cyan); }
    .hero-stat-label {
      margin: 3px 0 0;
      font-family: var(--font-body);
      font-size: 12px;
      color: #cbd5e1;
    }

    /* The card chrome lives on QuoteForm's own compact styles */
    .hero-form-card { align-self: start; scroll-margin-top: 96px; }

    @media (prefers-reduced-motion: no-preference) {
      .hero-pill-dot { animation: hero-pulse 2.4s ease-in-out infinite; }
    }
    @keyframes hero-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.35; }
    }

    @media (max-width: 900px) {
      .hero-section { min-height: auto; }
      .hero-inner {
        grid-template-columns: 1fr;
        padding: 44px 20px 48px;
        gap: 32px;
      }
      .hero-overlay {
        background:
          linear-gradient(to top, rgba(var(--hero-ink), 0.97) 0%, rgba(var(--hero-ink), 0.9) 20%, rgba(var(--hero-ink), 0) 45%),
          linear-gradient(rgba(var(--hero-ink), 0.72), rgba(var(--hero-ink), 0.72));
      }
      .hero-glow-a { left: 10%; }
      .hero-glow-b { display: none; }
      .hero-content { text-align: center; }
      .hero-badges { justify-content: center; }
      .hero-p { margin-inline: auto; text-align: left; } /* a long centred paragraph is hard to read */
      .hero-ctas { justify-content: center; flex-direction: column; align-items: stretch; }
      .hero-stats { justify-content: center; margin-inline: auto; }
    }
    @media (max-width: 480px) {
      .hero-stat { padding: 0 12px; }
      .hero-stat-value { font-size: 18px; flex-wrap: wrap; justify-content: center; gap: 3px; }
      .hero-stat-label { font-size: 11px; }
    }
  </style>
</Layout>
