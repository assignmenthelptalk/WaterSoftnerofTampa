---
export const prerender = true;

import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import LocalSchema from "../components/LocalSchema.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { site } from "../lib/site";
---

<Layout title={`Water Softeners in ${site.city}, ${site.stateAbbr}`}>
  <LocalSchema />

  <section class="section hero">
    <Image
      src="https://placehold.co/1920x1080/0A4F57/ffffff?text=Hero+Image+Placeholder"
      alt="Placeholder hero image — replace when provisioning a city site"
      width={1920}
      height={1080}
      class="hero-bg"
    />
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="container hero-grid">
      <div class="hero-content">
        <p class="hero-badge">{site.city}, {site.stateAbbr} Water Hardness: {site.gpgLow}–{site.gpgHigh} GPG ({site.gpgLabel})</p>
        <h1>Water Softeners in {site.city}, {site.stateAbbr}</h1>
        <p class="hero-text">{site.heroSubheading}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/quote/">Free Consultation</a>
          <a class="btn btn-secondary" href="/water-quality/">See {site.city}'s Water Report</a>
        </div>
      </div>
      <div class="hero-form-wrap">
        <QuoteForm heading="Free Water Test & Quote" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header center">
        <p class="eyebrow">Why {site.city} Homes Need a Softener</p>
        <h2>{site.gpgLabel} Water Is Hard on Your Home</h2>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <h3>Local Water Source</h3>
          <p>{site.city} draws its tap water from {site.waterSource}, managed by {site.waterAuthority}. At {site.gpgLow}–{site.gpgHigh} GPG, that water leaves mineral scale in pipes, water heaters, and appliances.</p>
        </div>
        <div class="card">
          <h3>Appliance Lifespan</h3>
          <p>Hard water buildup shortens the life of water heaters, dishwashers, and washing machines — costing {site.city} homeowners in early replacements and repairs.</p>
        </div>
        <div class="card">
          <h3>Local, Fast Installation</h3>
          <p>We install softeners for homes throughout {site.county}, including {site.neighbourhoods.slice(0, 3).join(", ")}.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header center">
        <span class="section-pill">Recommended for {site.city}</span>
        <h2>Water Softener Systems for {site.gpgLow}–{site.gpgHigh} GPG Hard Water</h2>
        <p>{site.city} water from {site.waterAuthority} tests at {site.gpgLow}–{site.gpgHigh} GPG — {site.gpgLabel}. Every system below is selected and sized for this exact hardness level.</p>
      </div>

      <div class="grid grid-3 product-grid">
        <div class="card product-card product-card-featured">
          <span class="badge">Best for {site.city}</span>
          <h3>Salt-Based Water Softener</h3>
          <p class="product-subtitle">Full hardness removal — the only system that works at {site.gpgLow}–{site.gpgHigh} GPG</p>
          <ul class="product-features">
            {[
              "Removes calcium and magnesium via ion exchange — not just crystallizes them like salt-free conditioners",
              `Sized for ${site.city}'s ${site.gpgLow}–${site.gpgHigh} GPG range: 32,000–64,000 grain capacity`,
              "Free water hardness test included with every consultation",
            ].map((item) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2.5 7.2 5.4 10 11.5 3.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <div class="product-ctas">
            <a class="btn btn-primary" href={site.affiliateSoftener} target="_blank" rel="noopener noreferrer">View Salt-Based Softeners →</a>
            <a class="product-outline-cta" href="/quote/">Get a Free Consultation</a>
          </div>
        </div>

        <div class="card product-card">
          <h3>Softener + Whole-Home Filter</h3>
          <p class="product-subtitle">Hardness removal plus filtration for {site.waterAuthority} supply</p>
          <ul class="product-features">
            {[
              "Combines ion exchange softening with carbon filtration",
              `Removes chlorine, sediment, and contaminants from ${site.waterSource}`,
              "One system, one installation, one maintenance schedule",
            ].map((item) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2.5 7.2 5.4 10 11.5 3.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <div class="product-ctas">
            <a class="btn btn-primary" href={site.affiliateCombo} target="_blank" rel="noopener noreferrer">View Combo Systems →</a>
            <a class="product-outline-cta" href="/quote/">Get a Free Consultation</a>
          </div>
        </div>

        <div class="card product-card">
          <h3>Reverse Osmosis System</h3>
          <p class="product-subtitle">Under-sink drinking water purification</p>
          <ul class="product-features">
            {[
              `Removes up to 99% of dissolved solids from ${site.waterAuthority} supply`,
              "Dedicated drinking water tap — eliminates bottled water",
              "Works best paired with a whole-home softener",
            ].map((item) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2.5 7.2 5.4 10 11.5 3.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <div class="product-ctas">
            <a class="btn btn-primary" href={site.affiliateRO} target="_blank" rel="noopener noreferrer">View RO Systems →</a>
            <a class="product-outline-cta" href="/quote/">Get a Free Consultation</a>
          </div>
        </div>
      </div>

      <div class="product-grid-cta">
        <p>Not sure which system is right for your home?</p>
        <a href="/quote/">Get a free water test and system recommendation →</a>
      </div>

      <p class="disclosure">Some links above are affiliate links. We may earn a commission at no extra cost to you if you purchase through them.</p>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container final-cta">
      <h2>Ready for Soft Water in {site.city}?</h2>
      <p>Get a free, no-obligation quote based on your home's water hardness and household size.</p>
      <a class="btn btn-primary" href="/quote/">Free Consultation</a>
    </div>
  </section>

  {site.serviceAreas.filter((a) => a.qdp.verified && a.qdp.verdict === "PASS").length > 0 && (
    <section class="homepage-service-areas">
      <div class="homepage-service-areas-inner">
        <h2>Areas We Serve Near {site.city}, {site.stateAbbr}</h2>
        <p>We serve {site.city} and surrounding {site.county} communities.</p>
        <div class="homepage-sa-grid">
          {site.serviceAreas
            .filter((a) => a.qdp.verified && a.qdp.verdict === "PASS")
            .map((area) => (
              <a href={`/${area.slug}/`} class="homepage-sa-card">
                <span class="sa-card-city">{area.city}</span>
                <span class="sa-card-detail">
                  {area.distanceFromPrimary} · {area.gpgLow}–{area.gpgHigh} GPG
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  )}

  <style>
    /* ---------- Hero: full-bleed image + gradient scrim ---------- */
    .hero { position: relative; overflow: hidden; padding-top: clamp(64px, 10vw, 120px); padding-bottom: clamp(64px, 10vw, 120px); color: #ffffff; }
    .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
    .hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(10, 47, 55, 0.88) 0%, rgba(10, 47, 55, 0.78) 60%, rgba(10, 47, 55, 0.92) 100%);
      mix-blend-mode: multiply;
      z-index: 1;
    }
    .hero-grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 48px;
      align-items: center;
    }
    .hero-badge {
      display: inline-flex;
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.75rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: var(--radius-full);
      padding: 8px 16px;
      margin: 0 0 20px;
    }
    .hero-content h1 { color: #ffffff; }
    .hero-text { font-size: 1.0625rem; max-width: 44ch; margin-bottom: 24px; color: rgba(255, 255, 255, 0.88); }
    .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
    .hero-form-wrap :global(.quote-form) { background: #ffffff; }
    .disclosure { font-size: 0.75rem; color: var(--color-text-muted); margin-top: 24px; }

    /* ---------- Product recommendation grid ---------- */
    .section-pill {
      display: inline-flex;
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.75rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--color-primary-dark, var(--color-primary));
      background: var(--color-primary-light);
      padding: 6px 16px;
      border-radius: var(--radius-full);
      margin-bottom: 4px;
    }
    .product-grid { margin-top: 32px; align-items: stretch; }
    .product-card { display: flex; flex-direction: column; position: relative; }
    .product-card-featured { border: 1.5px solid var(--color-primary); }
    .product-card-featured .badge {
      position: absolute;
      top: -12px;
      left: 24px;
      background: var(--color-accent);
      color: #ffffff;
    }
    .product-card h3 { margin-bottom: 6px; }
    .product-subtitle { font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 16px; }
    .product-features { list-style: none; margin: 0 0 24px; padding: 0; display: flex; flex-direction: column; gap: 10px; flex-grow: 1; }
    .product-features li { display: flex; align-items: flex-start; gap: 8px; font-size: 0.875rem; line-height: 1.5; }
    .product-features svg { color: var(--color-primary); flex-shrink: 0; margin-top: 4px; }
    .product-ctas { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-top: auto; }
    .product-outline-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 20px;
      border: 1.5px solid var(--color-primary);
      border-radius: var(--radius-brand);
      color: var(--color-primary);
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 0.875rem;
      text-decoration: none;
      background: transparent;
      transition: background-color 150ms ease, color 150ms ease, transform 150ms ease;
    }
    .product-outline-cta:hover { background: var(--color-primary); color: #ffffff; transform: translateY(-1px); }
    .product-outline-cta:active { transform: scale(0.98); }
    .product-outline-cta:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
    .product-grid-cta { text-align: center; margin-top: 32px; }
    .product-grid-cta p { font-family: var(--font-body); font-weight: 600; color: var(--color-text); margin-bottom: 6px; }
    .product-grid-cta a { font-weight: 600; }

    .final-cta { text-align: center; }
    .final-cta p { max-width: 48ch; margin: 0 auto 24px; }
    @media (max-width: 860px) {
      .hero-grid { grid-template-columns: 1fr; }
    }

    /* ---------- Service areas (only rendered when serviceAreas is non-empty) ---------- */
    .homepage-service-areas { padding: 72px 24px; background: var(--surface-base); }
    .homepage-service-areas-inner { max-width: 960px; margin: 0 auto; text-align: center; }
    .homepage-service-areas h2 {
      font-family: var(--font-heading);
      font-size: clamp(24px, 3.5vw, 38px);
      letter-spacing: -0.02em;
      color: var(--brand-primary);
      margin-bottom: 12px;
    }
    .homepage-service-areas p {
      font-family: var(--font-body);
      font-size: 16px;
      color: var(--color-text-muted);
      margin-bottom: 32px;
    }
    .homepage-sa-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 16px;
    }
    .homepage-sa-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding: 20px 24px;
      background: var(--color-surface);
      border: 1.5px solid var(--color-border);
      border-radius: var(--radius-lg);
      text-decoration: none;
      transition: border-color 200ms ease,
                  transform 200ms cubic-bezier(0.34,1.56,0.64,1),
                  box-shadow 200ms ease;
    }
    .homepage-sa-card:hover {
      border-color: var(--brand-primary);
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }
    .homepage-sa-card:focus-visible {
      outline: 3px solid var(--brand-primary);
      outline-offset: 2px;
    }
    .sa-card-city { font-family: var(--font-heading); font-size: 18px; color: var(--brand-secondary); }
    .sa-card-detail { font-family: var(--font-body); font-size: 12px; color: #9CA3AF; }
  </style>
</Layout>
